    "@types/react-dom": "^19.2.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.63.0",
